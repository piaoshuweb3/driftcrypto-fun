# Keep the deployment payload to what the app actually needs.
#
# Without this file Vercel uploads the whole working tree. That mattered: the
# local SQLite database travelled into the deployment, which both leaked local
# data off the machine and made the app read stale rows from a read-only copy
# instead of falling back to generating a report. (.gitignore does not apply
# here — Vercel uses its own rules.)

# build output and dependencies
node_modules
.next
.git

# local database — runtime data, never part of a build
db

# secrets
.env
.env.*
!.env.example

# not part of the running app
mini-services
skills
examples
agent-ctx
upload
download

# marketing screenshots
screenshot-*.png

# runtime state and logs
.bot-langs.json
dev.log
server.log
*.log
