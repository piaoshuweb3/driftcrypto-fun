# ---------------------------------------------------------------------------
# driftcrypto.fun — environment template
# ---------------------------------------------------------------------------
# Copy this file to `.env` and fill in real values.
# NEVER commit the filled `.env` (it is listed in .gitignore for a reason).
# ---------------------------------------------------------------------------

# --- Database (Prisma / SQLite) --------------------------------------------
# Relative SQLite paths are resolved from the `prisma/` directory,
# so `../db/custom.db` points at the project's db/custom.db.
DATABASE_URL="file:../db/custom.db"

# --- NextAuth (REQUIRED for any sign-in to work) ---------------------------
# Generate one with:  openssl rand -base64 32
NEXTAUTH_SECRET=""
NEXTAUTH_URL="http://localhost:3000"

# --- OAuth providers (optional) -------------------------------------------
# Leave empty to disable that button; sign-in will surface an error.
GOOGLE_ID=""
GOOGLE_SECRET=""
TWITTER_ID=""
TWITTER_SECRET=""

# --- Internal keys --------------------------------------------------------
# Guards POST /api/piao-shu/generate (admin + paid tiers).
# Send as the `x-generate-key` request header. Use a long random string.
PIAOSHU_GENERATE_KEY=""

# Guards /api/admin/* routes. Use a long random string, different from above.
ADMIN_SECRET_KEY=""

# --- Production database (Turso / libSQL) ----------------------------------
# Local development keeps using the file: URL above. In production point
# DATABASE_URL at your Turso database and add its token:
#   DATABASE_URL="libsql://<your-db>.turso.io"
#   TURSO_AUTH_TOKEN="<token>"
TURSO_AUTH_TOKEN=""

# --- AI provider (OpenAI-compatible) ---------------------------------------
# Any OpenAI-compatible endpoint works: OpenAI, DeepSeek, OpenRouter, Groq,
# a self-hosted vLLM, or a local Ollama (http://localhost:11434/v1).
AI_BASE_URL="https://api.openai.com/v1"
AI_API_KEY=""
AI_MODEL="gpt-4o-mini"

# --- Web search (optional) -------------------------------------------------
# Powers /api/news and the PiaoShu radar. Without it those fall back to the
# built-in sample data. Provider: "tavily" or "serper".
SEARCH_PROVIDER=""
SEARCH_API_KEY=""

# --- Telegram bot (mini-services/telegram-bot) ------------------------------
# Required: the bot exits on boot without it. Create or rotate via @BotFather.
TELEGRAM_BOT_TOKEN=""
# Where the bot reads data from. Defaults to the deployed site.
DRIFTCRYPTO_API_BASE="https://driftcrypto-fun.vercel.app"
# Public site URL for the links the bot sends. Defaults to the API base above.
DRIFTCRYPTO_SITE_URL=""
BOT_PORT="3002"

# --- Administrator login ---------------------------------------------------
# Username + password sign-in — the "Administrator" entry in the sign-in
# dialog. Leave ADMIN_PASSWORD empty to disable administrator sign-in.
ADMIN_USERNAME="admin"
ADMIN_PASSWORD=""

# --- Free AI endpoints (set AI_BASE_URL above to any of these) -------------
# The AI layer speaks OpenAI-compatible HTTP, so a free tier is enough:
#   Google Gemini  https://generativelanguage.googleapis.com/v1beta/openai/  model: gemini-2.0-flash
#   Groq           https://api.groq.com/openai/v1                            model: qwen/qwen3.8-27b
#   OpenRouter     https://openrouter.ai/api/v1                              model: meta-llama/llama-3.3-70b-instruct:free

# --- USDC payments ---------------------------------------------------------
# Address that receives membership payments. Any EVM address works on all of
# the supported chains (Polygon / Base / Arbitrum / Ethereum).
PAYMENT_RECEIVE_ADDRESS=""
# Optional per-chain RPC overrides; public endpoints are used by default.
# POLYGON_RPC_URL=""
# BASE_RPC_URL=""
# ARBITRUM_RPC_URL=""
# ETHEREUM_RPC_URL=""
