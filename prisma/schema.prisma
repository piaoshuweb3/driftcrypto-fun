generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Authentication & User Management (NextAuth.js compatible)
// ---------------------------------------------------------------------------

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  role          String    @default("user") // "admin" | "user"
  membership    String    @default("free") // "free" | "plus" | "pro"
  walletAddress String?   @unique
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts      Account[]
  sessions      Session[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String  // "oauth" | "wallet"
  provider          String  // "google" | "twitter" | "wallet"
  providerAccountId String  // Google sub / Twitter user ID / wallet address
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ---------------------------------------------------------------------------
// Market Data (existing)
// ---------------------------------------------------------------------------

model News {
  id           String   @id @default(cuid())
  sourceId     String   @default("unknown")
  externalId   String   @default("")
  url          String
  title        String
  summary      String?
  aiSummary    String?
  sentiment    String?  @default("neutral")
  language     String   @default("en")
  publishedAt  DateTime @default(now())
  scrapedAt    DateTime @default(now())
  contentHash  String?  @unique
  imageUrl     String?
  metadata     String?  // JSON string for tags, categories, etc.

  @@index([publishedAt])
  @@index([sourceId])
  @@index([sentiment])
}

model Price {
  id          String   @id @default(cuid())
  coinId      String
  symbol      String
  name        String
  usdPrice    Float
  change24h   Float?
  volume24h   Float?
  marketCap   Float?
  imageUrl    String?
  recordedAt  DateTime @default(now())

  @@index([coinId])
  @@index([recordedAt])
}

model FearGreedIndex {
  id         String   @id @default(cuid())
  value      Int
  label      String
  recordedAt DateTime @default(now())
}

model Subscription {
  id              String   @id @default(cuid())
  email           String
  coinIds         String   @default("[]") // JSON array
  keywords        String   @default("[]") // JSON array
  sources         String   @default("[]") // JSON array
  sentimentFilter String   @default("all")
  pushChannels    String   @default("{}") // JSON object
  pushSchedule    String   @default("daily")
  active          Boolean  @default(true)
  createdAt       DateTime @default(now())
}

// ---------------------------------------------------------------------------
// PiaoShu Daily Reports (飘叔分析 - paid content)
// ---------------------------------------------------------------------------

model PiaoShuReport {
  id            String   @id @default(cuid())
  reportDate    String   @unique   // "2026-06-04" format
  title         String             // "飘叔每日速报 · 2026-06-04"
  radarData     String             // JSON: CryptoRank 5 radar sections
  opportunityAnalysis String       // Markdown: rule-based opportunity analysis
  dailyDigest   String             // Markdown: 4-source daily digest
  piaoshuCommentary String         // Markdown: AI-generated 飘叔锐评
  marketOverview    String         // JSON: market snapshot data
  gainers       String             // JSON: top gainers
  losers        String             // JSON: top losers
  fundingRadar  String             // JSON: funding rounds
  upcomingICO   String             // JSON: upcoming IDO/ICO
  airdropRadar  String             // JSON: airdrops
  fullContent   String             // Full markdown report (combined)
  minMembership String   @default("plus") // "free" | "plus" | "pro" - minimum tier to view
  generatedAt   DateTime @default(now())
  createdAt     DateTime @default(now())

  @@index([reportDate])
  @@index([minMembership])
}
